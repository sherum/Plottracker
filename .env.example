# Copy to .env and fill in. .env is gitignored; never commit it.

# One key is enough. OpenRouter gives access to many models with a single key:
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Only needed if you point a model below at that provider directly.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Models are litellm model strings: <provider>/<model>. For OpenRouter models
# use openrouter/<vendor>/<model> (confirm the slug at https://openrouter.ai/models).
#
# ANALYSIS_MODEL runs ingestion and re-analysis: it reads the whole manuscript
# and returns structured topics, themes, and acts. A more powerful model is
# recommended here; it gives noticeably better story structure.
# SIDEKICK_MODEL answers questions and edits from short context; a fast, cheaper
# model is fine.
#
# Both default to openrouter/google/gemini-3.7-flash when unset.
# ANALYSIS_MODEL=openrouter/anthropic/claude-sonnet-5
# SIDEKICK_MODEL=openrouter/google/gemini-3.7-flash
#
# The sidekick answers sooner with a low reasoning effort (the default). Set it empty if
# your SIDEKICK_MODEL does not accept a reasoning setting.
# SIDEKICK_REASONING_EFFORT=low
